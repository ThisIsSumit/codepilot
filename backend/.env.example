# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codepilot?sslmode=disable

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Optional: configure these to enable email and Slack delivery
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SLACK_WEBHOOK_URL=

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Personal access token OR GitHub App installation token
GITHUB_TOKEN=ghp_...

# Secret from your GitHub App / webhook config
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub App credentials (optional — for installation-level auth)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app.pem
